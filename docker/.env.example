# Local Docker env for OSAKA Workation Supabase stack
# Keep ANON_KEY and SERVICE_ROLE_KEY aligned with docker/kong/kong.yml and .env.example.

POSTGRES_PASSWORD=your_postgres_password
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRY=3600

ANON_KEY=your_supabase_anon_key
SERVICE_ROLE_KEY=your_supabase_service_role_key

API_EXTERNAL_URL=http://127.0.0.1:54321
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/auth/callback,http://127.0.0.1:3000/auth/callback

POSTGRES_PORT=54322
KONG_HTTP_PORT=54321
STUDIO_PORT=54323
INBUCKET_PORT=54324

ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_HOST=mail
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
