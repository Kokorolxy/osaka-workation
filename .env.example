# Copy to `.env.local` and fill in values.
#
# --- Local Docker Supabase (recommended) ---
#   docker compose --env-file docker/.env up -d --build
# Keys below match docker/.env (Supabase local demo JWTs).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Registration gate: set to false to block new sign-ups.
REGISTRATION_OPEN=true

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Hosted Supabase ---
# Replace the three values above with Project Settings → API from your dashboard.

# --- Stripe (local test mode first) ---
# Dashboard → Developers → API keys (Test mode ON)
STRIPE_SECRET_KEY=sk_test_...
# From Stripe CLI: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

